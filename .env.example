# Sem valor: SQLite local. Para Neon, configure a variável no ambiente.
# Apenas documentação: npm start não carrega .env automaticamente.
DATABASE_URL=
PORT=3000
# Cookies Secure são automáticos na Vercel; use production em produção externa.
NODE_ENV=development
# Sessões opacas persistidas no banco dispensam segredo de assinatura adicional.
